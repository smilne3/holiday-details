# Don't run dependencies' install scripts (preinstall, install, postinstall) on `npm ci` or
# `npm install`. The Mac, CI and Vercel's install all read this file.
#
# Install scripts are how this year's npm worms spread, and nothing here needs them. Only one
# locked package has one: fsevents (optional, macOS only). Every CI step passes without it.
#
# `npm run <script>` still runs the named script. Only its pre- and post- hooks are skipped, and
# package.json defines none. If a dependency ever really needs its install script, run just that
# one: `npm rebuild <pkg> --ignore-scripts=false`. A plain `npm rebuild` obeys this file and skips it.
ignore-scripts=true
